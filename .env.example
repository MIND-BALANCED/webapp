# Enlace público de agenda (Cal.com, Calendly o similar)
NEXT_PUBLIC_SCHEDULING_URL=https://cal.com/tu-usuario/valoracion-inicial

# Correo de contacto que se muestra en la política de datos
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (solo servidor). Sin estas variables el formulario funciona en modo demostración y no guarda nada.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
